# DDUnlimited Forum Credentials
DDU_USERNAME=your_username
DDU_PASSWORD=your_password

# Database
DATABASE_PATH=ddunlimited.db

# Pages file (path to the file containing pages to scrape)
PAGES_FILE=pages.txt

# Scraper Settings
REQUEST_DELAY=1.5
REQUEST_TIMEOUT=30

# Flask Settings
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=False

# Browser session relay
# Shared secret the browser extension sends in the X-Session-Token header.
# Leave empty to disable the endpoint.
SESSION_TOKEN=
# Where the captured cookies are stored (default: alongside the database)
# SESSION_FILE=data/session.json

# Scheduler Settings (for automatic reimportation)
# These are the defaults; the admin page overrides them and its values win.
# SCRAPE_ENABLED: Set to false to stop automatic imports (default: true)
# SCRAPE_INTERVAL_DAYS: How many days to wait between imports (default: 3)
# SCRAPE_HOUR: Hour of the day to run import (24h format, default: 2 = 2 AM)
# SCRAPE_MINUTE: Minute of the hour to run import (default: 0)
SCRAPE_ENABLED=true
SCRAPE_INTERVAL_DAYS=3
SCRAPE_HOUR=2
SCRAPE_MINUTE=0

# Logging level: DEBUG, INFO, WARNING, ERROR (default: INFO)
# Set to DEBUG to see every title found during Single Import
LOG_LEVEL=INFO

# Post detail scraping: visita ogni singolo post per estrarre quality, lingue, codec dall'h4/h2
# Piu' lento ma dati piu' ricchi (languages, status, codec completi)
SCRAPE_POST_DETAILS=true
# Numero di richieste parallele ai singoli post (max consigliato: 5)
POST_DETAIL_WORKERS=3

# Un topic viene riletto una volta sola, questi giorni dopo la creazione.
# Il titolo puo' cambiare nei primi giorni di vita del post, dopo non piu':
# i topic vecchi non vengono mai riscaricati.
POST_RECHECK_DAYS=30

# Voti esterni (TMDB per l'abbinamento, OMDb per il voto IMDb)
# TMDB: chiave gratuita da https://www.themoviedb.org/settings/api
# OMDb: chiave gratuita da https://www.omdbapi.com/apikey.aspx (1000 chiamate al giorno)
RATINGS_ENABLED=true
TMDB_API_KEY=
OMDB_API_KEY=
# Lingua con cui TMDB restituisce titoli e locandine
TMDB_LANGUAGE=it-IT
# Pausa fra due richieste a TMDB (il limite e' circa 50 al secondo)
TMDB_REQUEST_DELAY=0.05
# Quante chiamate OMDb al giorno, sotto il tetto del piano gratuito
OMDB_DAILY_LIMIT=900
# Sotto questa confidenza l'abbinamento finisce nella pagina /ratings
RATING_MIN_CONFIDENCE=0.75
# Quanti titoli legge dal database in un colpo solo mentre abbina
RATING_BATCH_SIZE=500
# Tetto di una singola passata, per non bloccare l'import quando l'arretrato e' grosso
RATING_MAX_PER_RUN=5000
